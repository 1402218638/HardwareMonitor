<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HardwareMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 主题色：CPU 蓝 / GPU 绿 / 电池 琥珀 -->
            <Color x:Key="CpuAccentColor">#4CC2FF</Color>
            <Color x:Key="GpuAccentColor">#6CCB5F</Color>
            <Color x:Key="BatteryAccentColor">#FFB900</Color>
            <SolidColorBrush x:Key="CpuAccentBrush" Color="{StaticResource CpuAccentColor}"/>
            <SolidColorBrush x:Key="GpuAccentBrush" Color="{StaticResource GpuAccentColor}"/>
            <SolidColorBrush x:Key="BatteryAccentBrush" Color="{StaticResource BatteryAccentColor}"/>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="MiniBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
