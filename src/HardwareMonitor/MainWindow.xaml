<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HardwareMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HardwareMonitor.Controls"
    Title="Hardware Monitor">

    <Grid RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="#4CC2FF"/>
                <TextBlock Text="Hardware Monitor" VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Padding="16,4,16,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="刷新间隔" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="IntervalCombo" SelectedIndex="0" MinWidth="110"
                          SelectionChanged="IntervalCombo_SelectionChanged">
                    <ComboBoxItem Content="1 秒"/>
                    <ComboBoxItem Content="2 秒"/>
                    <ComboBoxItem Content="5 秒"/>
                </ComboBox>
            </StackPanel>
            <ToggleButton x:Name="TopMostToggle" Checked="TopMostToggle_Changed" Unchecked="TopMostToggle_Changed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE718;" FontSize="14"/>
                    <TextBlock Text="窗口置顶"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="2" Padding="16,4,16,4" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <InfoBar x:Name="AdminInfoBar" Severity="Warning" IsClosable="True" IsOpen="False"
                         Title="建议以管理员身份运行"
                         Message="当前未以管理员身份运行，CPU 温度 / 功耗 / 频率等传感器可能无法读取。请右键应用并选择“以管理员身份运行”。"/>

                <Grid ColumnSpacing="12" MinHeight="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU 卡片 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource CpuAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CPU" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CpuNameText" Text="正在检测…" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="温度" Style="{StaticResource MetricLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="CpuTempText" Text="--" FontSize="44" FontWeight="SemiBold"/>
                                    <TextBlock Text="°C" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <controls:Sparkline x:Name="CpuTempSpark" Height="52" SparkStroke="#4CC2FF"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="功耗" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="CpuPowerText" Text="-- W" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="占用率" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="CpuLoadText" Text="-- %" Style="{StaticResource MetricValueStyle}"/>
                                    <ProgressBar x:Name="CpuLoadBar" Style="{StaticResource MiniBarStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="频率" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="CpuClockText" Text="-- GHz" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GPU 卡片 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource GpuAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="GPU" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GpuNameText" Text="正在检测…" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="温度" Style="{StaticResource MetricLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="GpuTempText" Text="--" FontSize="44" FontWeight="SemiBold"/>
                                    <TextBlock Text="°C" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <controls:Sparkline x:Name="GpuTempSpark" Height="52" SparkStroke="#6CCB5F"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="功耗" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="GpuPowerText" Text="-- W" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="占用率" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="GpuLoadText" Text="-- %" Style="{StaticResource MetricValueStyle}"/>
                                    <ProgressBar x:Name="GpuLoadBar" Style="{StaticResource MiniBarStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="频率" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="GpuClockText" Text="-- GHz" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 电池卡片 -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource BatteryAccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="电池" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BatteryStatusText" Text="--" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="BatteryPill" CornerRadius="10" Padding="10,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#33808080">
                                    <TextBlock x:Name="BatteryPillText" Text="未知" FontSize="11" Foreground="#C8C8C8"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="充放电功率" Style="{StaticResource MetricLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="BatteryPowerText" Text="--" FontSize="44" FontWeight="SemiBold"/>
                                    <TextBlock Text="W" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="正值表示充电，负值表示放电" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>

                            <controls:Sparkline x:Name="BatteryPowerSpark" Height="52" SparkStroke="#FFB900" ScaleFromZero="True"/>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="剩余电量" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="BatteryPercentText" Text="-- %" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BatteryBar" Style="{StaticResource MiniBarStyle}"/>
                                <TextBlock x:Name="BatteryCapacityText" Text="-- Wh / -- Wh" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 全部传感器（调试视图） -->
                <Expander x:Name="SensorExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="全部传感器（调试视图）"/>
                    </Expander.Header>
                    <ListView x:Name="SensorList" MaxHeight="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Opacity="0.85"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Grid Grid.Row="3" Padding="16,6,16,10">
            <TextBlock x:Name="UpdateTimeText" Text="尚未更新" FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="数据来源：LibreHardwareMonitorLib" FontSize="12" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
